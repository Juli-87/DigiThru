{
 "id": "digithru",
 "version": "0.1",
 "title": "DigiThru (PB/AT/MW to MIDI tracks)",
 "category": "MIDI",
 "author": "Juli-87",
 "license": "GPL-2.0-or-later",
 "description": "Pitch bend, aftertouch (channel and poly) and the mod wheel arriving on the AUTO channel go out on the active MIDI track's channel, like its notes. Leaving the track centres its pitch bend and clears its pressure.",
 "device": "digitakt-mk1",
 "os": "1.53",
 "sources": ["digithru.c"],
 "cflags": [
  "-DSEQ_SEND_AT=0x400e076a",
  "-DMTRK_CHAN_AT=0x400e07b0",
  "-DACTIVE_TRACK_AT=0x4197b6b4",
  "-DAUTO_CHAN_AT=0x4197b6fc",
  "-DRX_NOTES_AT=0x4197b778"
 ],
 "sites": [
  {"addr": "0x401b8a7c", "stock": "400d427e", "op": "ptr", "target": "dt_polypress"},
  {"addr": "0x401b8a88", "stock": "400d4280", "op": "ptr", "target": "dt_chanpress"},
  {"addr": "0x401b8a8c", "stock": "400d4282", "op": "ptr", "target": "dt_pitchbend"}
 ],
 "subscribe": [
  {"event": "ev_midi_cc", "fn": "dt_cc", "order": 50},
  {"event": "ev_tick", "fn": "dt_tick", "order": 50}
 ],
 "resources": {"core": "4.3"},
 "requires": ["core"]
}
