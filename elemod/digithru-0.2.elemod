{
 "elemod": 2,
 "id": "digithru",
 "version": "0.2",
 "title": "DigiThru (PB/AT/MW to MIDI tracks)",
 "description": "Pitch bend, aftertouch (channel and poly) and the mod wheel (CC 1/33) arriving on the AUTO channel go out on the active MIDI track's channel, like its notes. Leaving the track centres its pitch bend and clears its pressure.",
 "category": "MIDI",
 "author": "Juli-87",
